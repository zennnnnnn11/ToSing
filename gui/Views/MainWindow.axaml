<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SubParser.Gui.Views.MainWindow"
    Title="SubParser"
    Width="840"
    Height="519"
    MinWidth="760"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    TransparencyLevelHint="Mica, AcrylicBlur"
    Background="Transparent"
>
    <Window.Styles>
        <!-- 全局字体体系：统一定制为 MiSans，按控件角色精细划分字重与排版层级 -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="MiSans, -apple-system, sans-serif" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="MiSans, Cascadia Code, monospace" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="SelectionBrush" Value="#250078D4" />
            <Setter Property="SelectionForegroundBrush" Value="#0F172A" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="MiSans, -apple-system, sans-serif" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="MiSans, -apple-system, sans-serif" />
        </Style>

        <!-- 彻底消除 TextBox 默认的刺眼亮蓝高亮边框，保持细腻浅灰发丝级质感 -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 工具栏小图标按钮 -->
        <Style Selector="Button.tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,3.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.tool-btn:pointerover">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <!-- 主转换按钮：扎实横向铺满，Fluent 经典渐变 -->
        <Style Selector="Button.hero-btn">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.hero-btn:pointerover">
            <Setter Property="Background" Value="#106EBE" />
        </Style>
        <Style Selector="Button.hero-btn:pressed">
            <Setter Property="Background" Value="#005A9E" />
        </Style>

        <!-- 次级操作按钮 -->
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Windows 11 Fluent 浅色半透明背景衬底 -->
        <Border Background="#C0F3F4F6" />

        <Grid RowDefinitions="Auto, *">
            <!-- 沉浸式标题栏：与操作系统融为一体，左侧品牌，右侧留空给原生控制按钮 -->
            <Border
                Grid.Row="0"
                Height="40"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
            >
                <Grid ColumnDefinitions="Auto, *">
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="16,0,0,0"
                    >
                        <!-- 流线型数据转换微标矢量图标 -->
                        <Border Width="20" Height="20" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#0078D4" />
                                    <GradientStop Offset="1" Color="#1E90FF" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path
                                Data="M 3 6 L 12 6 M 9 3 L 12 6 L 9 9 M 13 11 L 4 11 M 7 8 L 4 11 L 7 14"
                                Stroke="White"
                                StrokeThickness="1.5"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="13"
                                Height="13"
                                Stretch="Uniform"
                            />
                        </Border>

                        <TextBlock
                            Text="SubParser"
                            FontWeight="SemiBold"
                            FontSize="13.5"
                            Foreground="#0F172A"
                            VerticalAlignment="Center"
                        />

                        <Border
                            Background="#EEF2FF"
                            BorderBrush="#C7D2FE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1"
                            Margin="4,0,0,0"
                        >
                            <TextBlock
                                Text="v1.0.0"
                                FontSize="10.5"
                                FontWeight="Medium"
                                Foreground="#4338CA"
                            />
                        </Border>
                    </StackPanel>

                    <!-- 右侧占位：Windows 原生控件按钮覆盖区 -->
                    <Panel Grid.Column="1" Background="Transparent" />
                </Grid>
            </Border>

            <!-- 主工作台：纯白高质感微圆角卡片 -->
            <Panel Grid.Row="1" Margin="16,0,16,14">
                <Border
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 4 16 #0C000000"
                    Padding="14"
                >
                    <!-- 左右对称双栏工作台布局 -->
                    <Grid ColumnDefinitions="*, 1, *">
                        <!-- ==================== 左栏：输入与控制区 ==================== -->
                        <Grid
                            Grid.Column="0"
                            RowDefinitions="Auto, *, Auto, Auto"
                            Margin="0,0,10,0"
                        >
                            <!-- 左栏顶部工具栏 -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="6"
                                >
                                    <TextBlock
                                        Text="数据输入"
                                        FontWeight="SemiBold"
                                        FontSize="13"
                                        Foreground="#0F172A"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock
                                        Text="· 文本或文件"
                                        FontWeight="Normal"
                                        FontSize="11"
                                        Foreground="#94A3B8"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>

                                <!-- 文件浏览与清空按钮 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Classes="tool-btn"
                                        Click="OnBrowseFileClick"
                                        ToolTip.Tip="选择本地订阅文件 (.yaml, .txt, .json)"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Path
                                                Data="M 2 4 C 2 2.9 2.9 2 4 2 L 7 2 L 9 4 L 14 4 C 15.1 4 16 4.9 16 6 L 16 12 C 16 13.1 15.1 14 14 14 L 4 14 C 2.9 14 2 13.1 2 12 Z"
                                                Stroke="{Binding $parent[Button].Foreground}"
                                                StrokeThickness="1.2"
                                                Fill="Transparent"
                                                Width="14"
                                                Height="14"
                                                Stretch="Uniform"
                                            />
                                            <TextBlock
                                                Text="浏览"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Classes="tool-btn"
                                        Click="OnClearInputClick"
                                        ToolTip.Tip="清空输入框"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Path
                                                Data="M 3 5 L 13 5 M 5 5 L 5 13 C 5 13.6 5.4 14 6 14 L 10 14 C 10.6 14 11 13.6 11 13 L 11 5 M 6 5 L 6 3.5 C 6 3.2 6.2 3 6.5 3 L 9.5 3 C 9.8 3 10 3.2 10 3.5 L 10 5"
                                                Stroke="{Binding $parent[Button].Foreground}"
                                                StrokeThickness="1.2"
                                                Fill="Transparent"
                                                Width="13"
                                                Height="13"
                                                Stretch="Uniform"
                                            />
                                            <TextBlock
                                                Text="清空"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 多功能混合输入框（纵向自适应撑满） -->
                            <Border
                                Grid.Row="1"
                                Name="InputDropBorder"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Stretch"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnInputDragOver"
                                DragDrop.Drop="OnInputDrop"
                            >
                                <TextBox
                                    Name="InputTextBox"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Stretch"
                                    Watermark="在此粘贴订阅链接 (HTTP/HTTPS)、Base64 密文、节点 URI 列表、Clash YAML，或将本地文件直接拖拽至此处..."
                                    FontWeight="Normal"
                                    FontSize="11.5"
                                    Foreground="#0F172A"
                                    Padding="10,8"
                                />
                            </Border>

                            <!-- 选项开关行：舒适的纵向呼吸感 -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,10,0,12">
                                <CheckBox
                                    Name="FilterAdsCheckBox"
                                    Grid.Column="0"
                                    IsChecked="True"
                                    Content="自动过滤广告与过期提示节点"
                                    FontWeight="Normal"
                                    FontSize="11.5"
                                    Foreground="#334155"
                                />
                            </Grid>

                            <!-- 主操作按钮：横向铺满左栏底端，左右重量彻底平衡 -->
                            <Button
                                Grid.Row="3"
                                Name="ConvertButton"
                                Classes="hero-btn"
                                Height="34"
                                HorizontalAlignment="Stretch"
                                Click="OnConvertClick"
                            >
                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                >
                                    <Path
                                        Data="M 7 1 L 2 9 L 6 9 L 5 15 L 12 7 L 8 7 Z"
                                        Fill="White"
                                        Width="12"
                                        Height="14"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock
                                        Name="ConvertButtonText"
                                        Text="解析并转换"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 中间浅灰色纵向分割发丝线 -->
                        <Border Grid.Column="1" Background="#F1F5F9" Width="1" Margin="0,2" />

                        <!-- ==================== 右栏：结果展示与导出区 ==================== -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" Margin="10,0,0,0">
                            <!-- 右栏顶部结果徽标与状态栏 -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="sing-box 配置"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Foreground="#0F172A"
                                    VerticalAlignment="Center"
                                />

                                <!-- 结果徽标容器 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <!-- 初始就绪指示 -->
                                    <Border
                                        Name="InitialBadge"
                                        Background="#F1F5F9"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                    >
                                        <TextBlock
                                            Text="等待解析"
                                            FontSize="10.5"
                                            FontWeight="Medium"
                                            Foreground="#64748B"
                                        />
                                    </Border>

                                    <!-- 成功节点数量徽标 (带悬停协议浮窗) -->
                                    <Border
                                        Name="NodeCountBadge"
                                        IsVisible="False"
                                        Background="#DCFCE7"
                                        BorderBrush="#86EFAC"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Cursor="Hand"
                                        ToolTip.Placement="Bottom"
                                        ToolTip.ShowDelay="80"
                                    >
                                        <TextBlock
                                            Name="NodeCountText"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#15803D"
                                        />
                                    </Border>

                                    <!-- 清洗广告数量徽标 -->
                                    <Border
                                        Name="FilteredBadge"
                                        IsVisible="False"
                                        Background="#FEF9C3"
                                        BorderBrush="#FDE047"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                    >
                                        <TextBlock
                                            Name="FilteredText"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#854D0E"
                                        />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- JSON 代码预览框（纵向自适应撑满，与左侧平齐，边框温润克制） -->
                            <Border
                                Grid.Row="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Stretch"
                                Margin="0,0,0,10"
                            >
                                <TextBox
                                    Name="OutputTextBox"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    VerticalAlignment="Stretch"
                                    Watermark="解析后的标准 sing-box 节点出站配置将在此处实时显示..."
                                    FontWeight="Normal"
                                    FontSize="11.5"
                                    Foreground="#0F172A"
                                    Padding="10,8"
                                />
                            </Border>

                            <!-- 底部操作按钮栏（高度 34px，与左侧主按钮水平严格对齐） -->
                            <Grid Grid.Row="2" ColumnDefinitions="*, *" Height="34">
                                <Button
                                    Name="CopyButton"
                                    Grid.Column="0"
                                    Classes="action-btn"
                                    Margin="0,0,4,0"
                                    Click="OnCopyClick"
                                >
                                    <StackPanel
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="6"
                                    >
                                        <Path
                                            Data="M 4 4 L 10 4 C 11.1 4 12 4.9 12 6 L 12 12 C 12 13.1 11.1 14 10 14 L 4 14 C 2.9 14 2 13.1 2 12 L 2 6 C 2 4.9 2.9 4 4 4 Z M 6 2 L 12 2 C 13.1 2 14 2.9 14 4 L 14 10"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeThickness="1.2"
                                            Fill="Transparent"
                                            Width="13"
                                            Height="13"
                                            Stretch="Uniform"
                                        />
                                        <TextBlock
                                            Name="CopyButtonText"
                                            Text="复制配置"
                                            FontSize="11.5"
                                            FontWeight="Medium"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Name="SaveButton"
                                    Grid.Column="1"
                                    Classes="action-btn"
                                    Margin="4,0,0,0"
                                    Click="OnSaveClick"
                                >
                                    <StackPanel
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="6"
                                    >
                                        <Path
                                            Data="M 3 2 L 11 2 L 13 4 L 13 12 C 13 12.6 12.6 13 12 13 L 3 13 C 2.4 13 2 12.6 2 12 L 2 3 C 2 2.4 2.4 2 3 2 Z M 4 2 L 4 5 L 10 5 L 10 2 M 4 9 L 10 9"
                                            Stroke="{Binding $parent[Button].Foreground}"
                                            StrokeThickness="1.2"
                                            Fill="Transparent"
                                            Width="13"
                                            Height="13"
                                            Stretch="Uniform"
                                        />
                                        <TextBlock
                                            Text="保存文件"
                                            FontSize="11.5"
                                            FontWeight="Medium"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Panel>
        </Grid>
    </Panel>
</Window>

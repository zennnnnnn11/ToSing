<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ToSing.Gui.Views.MainWindow"
    Title="ToSing"
    Width="840"
    Height="519"
    MinWidth="760"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    TransparencyLevelHint="Mica, AcrylicBlur"
    Background="Transparent"
>
    <Window.Resources>
        <!-- 覆盖 Avalonia 默认 Fluent 画刷：锁死悬停时的文字与水印前景色，只有点击/聚焦时才变灰 -->
        <SolidColorBrush x:Key="TextControlForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#64748B" />

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#CBD5E1" />

        <!-- 彻底透明化 TextBox 原生边框与背景，无缝融入现代全景极简界面 -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    </Window.Resources>

    <Window.Styles>
        <!-- 全局字体体系：统一定制为 MiSans，按控件角色精细划分字重与排版层级 -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="MiSans, -apple-system, sans-serif" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="MiSans, Cascadia Code, monospace" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="SelectionBrush" Value="#250078D4" />
            <Setter Property="SelectionForegroundBrush" Value="#0F172A" />
        </Style>

        <!-- 默认水印与文本呈现器颜色 -->
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>

        <!-- 鼠标划过悬停（Hover / pointerover）时：文字与水印绝对不变灰，保持清晰稳定 -->
        <Style Selector="TextBox:pointerover">
            <Setter Property="Foreground" Value="#0F172A" />
            <Style Selector="^ /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Watermark">
                <Setter Property="Foreground" Value="#94A3B8" />
            </Style>
        </Style>

        <Style Selector="TextBox[IsReadOnly=True]:pointerover">
            <Setter Property="Foreground" Value="#0F172A" />
            <Style Selector="^ /template/ TextBlock#PART_Watermark">
                <Setter Property="Foreground" Value="#94A3B8" />
            </Style>
        </Style>

        <!-- 只有点上去（点击/按下/获取焦点 Focus/Pressed）时：文字与水印才变灰进行交互反馈 -->
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="#64748B" />
            <Style Selector="^ /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Watermark">
                <Setter Property="Foreground" Value="#CBD5E1" />
            </Style>
        </Style>

        <Style Selector="TextBox[IsReadOnly=True]:focus">
            <Setter Property="Foreground" Value="#64748B" />
            <Style Selector="^ /template/ TextBlock#PART_Watermark">
                <Setter Property="Foreground" Value="#CBD5E1" />
            </Style>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="MiSans, -apple-system, sans-serif" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="MiSans, -apple-system, sans-serif" />
        </Style>

        <!-- 工具栏小图标按钮 -->
        <Style Selector="Button.tool-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,3.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="TextBlock.Foreground" Value="#0F172A" />
        </Style>
        <Style Selector="Button.tool-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="TextBlock.Foreground" Value="#64748B" />
        </Style>

        <!-- 主转换按钮：Fluent 标志性蓝色，微动渐变呼吸反馈 -->
        <Style Selector="Button.hero-btn">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 悬停态：穿透 ContentPresenter，坚决保持明亮高质感微光蓝，文字坚决保持纯白 -->
        <Style Selector="Button.hero-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1084DE" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>
        <!-- 按下态：穿透 ContentPresenter，沉稳微下潜深蓝，文字坚决保持纯白 -->
        <Style Selector="Button.hero-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#006CBE" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>

        <!-- 次级操作按钮：比例收拢为 110×36 黄金比，精致饱满 -->
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
            <Setter Property="TextBlock.Foreground" Value="#0F172A" />
        </Style>
        <Style Selector="Button.action-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="TextBlock.Foreground" Value="#64748B" />
        </Style>
        <Style Selector="Button.action-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="TextBlock.Foreground" Value="#94A3B8" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- 微型幽灵图标按钮样式 (小齿轮) -->
        <Style Selector="Button.ghost-icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost-icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9" />
        </Style>
        <Style Selector="Button.ghost-icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0" />
        </Style>

        <!-- 药丸删除微按钮 -->
        <Style Selector="Button.chip-remove-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip-remove-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="TextBlock.Foreground" Value="#EF4444" />
        </Style>

        <!-- 药丸添加按钮 -->
        <Style Selector="Button.chip-add-btn">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip-add-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1084DE" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>

        <!-- 纯文本链接按钮 -->
        <Style Selector="Button.link-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.Foreground" Value="#0078D4" />
        </Style>

        <!-- 危险操作文本链接 (清空全部) -->
        <Style Selector="Button.link-btn-danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.link-btn-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.Foreground" Value="#EF4444" />
        </Style>

        <!-- FlyoutPresenter 无缝边框与无内边距适配 -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Windows 11 Fluent 纯白背景衬底 (全窗口一体化画布，彻底告别套框) -->
        <Border Background="#FFFFFF" />

        <Grid RowDefinitions="40, *">
            <!-- 沉浸式标题栏：与操作系统融为一体，左侧品牌，右侧留空给原生控制按钮 -->
            <Border
                Grid.Row="0"
                Height="40"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
            >
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock
                        Grid.Column="0"
                        Text="ToSing"
                        FontWeight="SemiBold"
                        FontSize="13.5"
                        Foreground="#0F172A"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0"
                    />

                    <!-- 右侧占位：Windows 原生控件按钮覆盖区 -->
                    <Panel Grid.Column="1" Background="Transparent" />
                </Grid>
            </Border>

            <!-- 主工作台：全窗口一体化通透双栏，中间由一条发丝竖线自然分隔，彻底消灭嵌套框！ -->
            <Grid Grid.Row="1" ColumnDefinitions="*, 33, *" Margin="18,4,18,18">
                <!-- ==================== 左翼：输入区 ==================== -->
                <Grid Grid.Column="0" RowDefinitions="28, *, 20, 36">
                    <!-- Row 0: 左栏顶部工具栏 (高度 28px) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                        >
                            <TextBlock
                                Text="数据输入"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Foreground="#0F172A"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Text="· 文本或文件"
                                FontWeight="Normal"
                                FontSize="11"
                                Foreground="#94A3B8"
                                VerticalAlignment="Center"
                            />
                        </StackPanel>

                        <!-- 文件浏览与清空按钮 -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                        >
                            <Button
                                Classes="tool-btn"
                                Click="OnBrowseFileClick"
                                ToolTip.Tip="选择本地订阅文件 (.yaml, .txt, .json)"
                            >
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path
                                        Data="M 2 4 C 2 2.9 2.9 2 4 2 L 7 2 L 9 4 L 14 4 C 15.1 4 16 4.9 16 6 L 16 12 C 16 13.1 15.1 14 14 14 L 4 14 C 2.9 14 2 13.1 2 12 Z"
                                        Stroke="{Binding $parent[Button].Foreground}"
                                        StrokeThickness="1.2"
                                        Fill="Transparent"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                    />
                                    <TextBlock
                                        Text="浏览"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                            </Button>

                            <Button
                                Classes="tool-btn"
                                Click="OnClearInputClick"
                                ToolTip.Tip="清空输入框"
                            >
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path
                                        Data="M 3 5 L 13 5 M 5 5 L 5 13 C 5 13.6 5.4 14 6 14 L 10 14 C 10.6 14 11 13.6 11 13 L 11 5 M 6 5 L 6 3.5 C 6 3.2 6.2 3 6.5 3 L 9.5 3 C 9.8 3 10 3.2 10 3.5 L 10 5"
                                        Stroke="{Binding $parent[Button].Foreground}"
                                        StrokeThickness="1.2"
                                        Fill="Transparent"
                                        Width="13"
                                        Height="13"
                                        Stretch="Uniform"
                                    />
                                    <TextBlock
                                        Text="清空"
                                        FontSize="11"
                                        FontWeight="Medium"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: 多功能混合输入框 (完全无框通透，左边缘与标题绝对平齐) -->
                    <TextBox
                        Grid.Row="1"
                        Name="InputTextBox"
                        Background="Transparent"
                        BorderThickness="0"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalAlignment="Stretch"
                        Watermark="在此粘贴订阅链接 (HTTP/HTTPS)、Base64 密文、节点 URI 列表、Clash YAML，或将本地文件直接拖拽至此处..."
                        FontWeight="Normal"
                        FontSize="11.5"
                        Foreground="#0F172A"
                        Padding="0,6,0,0"
                        Margin="0,8,0,10"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnInputDragOver"
                        DragDrop.Drop="OnInputDrop"
                    />

                    <!-- Row 2: 选项开关行 (高度严格 20px，下边距 10px) -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,10">
                        <CheckBox
                            Name="FilterAdsCheckBox"
                            Grid.Column="0"
                            IsChecked="True"
                            Content="自动过滤广告与过期提示节点"
                            FontWeight="Normal"
                            FontSize="11.5"
                            Foreground="#334155"
                            Margin="-3,0,0,0"
                            VerticalAlignment="Center"
                        />

                        <!-- 屏蔽词规则标签管理小齿轮与药丸标签流浮窗 -->
                        <Button
                            Name="FilterRulesButton"
                            Grid.Column="1"
                            Classes="ghost-icon-btn"
                            Width="20"
                            Height="20"
                            Padding="0"
                            Margin="4,0,0,0"
                            ToolTip.Tip="管理屏蔽词标签"
                            VerticalAlignment="Center"
                        >
                            <Path
                                Data="M 9.5 2 C 9.5 1.7 9.3 1.5 9 1.5 L 7 1.5 C 6.7 1.5 6.5 1.7 6.5 2 L 6.5 2.8 C 6.1 3 5.7 3.2 5.3 3.5 L 4.6 2.9 C 4.4 2.7 4.1 2.7 3.9 2.9 L 2.5 4.3 C 2.3 4.5 2.3 4.8 2.5 5 L 3.1 5.7 C 2.9 6.1 2.7 6.5 2.5 6.9 L 1.7 6.9 C 1.4 6.9 1.2 7.1 1.2 7.4 L 1.2 9.4 C 1.2 9.7 1.4 9.9 1.7 9.9 L 2.5 9.9 C 2.7 10.3 2.9 10.7 3.1 11.1 L 2.5 11.8 C 2.3 12 2.3 12.3 2.5 12.5 L 3.9 13.9 C 4.1 14.1 4.4 14.1 4.6 13.9 L 5.3 13.3 C 5.7 13.6 6.1 13.8 6.5 14 L 6.5 14.8 C 6.5 15.1 6.7 15.3 7 15.3 L 9 15.3 C 9.3 15.3 9.5 15.1 9.5 14.8 L 9.5 14 C 9.9 13.8 10.3 13.6 10.7 13.3 L 11.4 13.9 C 11.6 14.1 11.9 14.1 12.1 13.9 L 13.5 12.5 C 13.7 12.3 13.7 12 13.5 11.8 L 12.9 11.1 C 13.1 10.7 13.3 10.3 13.5 9.9 L 14.3 9.9 C 14.6 9.9 14.8 9.7 14.8 9.4 L 14.8 7.4 C 14.8 7.1 14.6 6.9 14.3 6.9 L 13.5 6.9 C 13.3 6.5 13.1 6.1 12.9 5.7 L 13.5 5 C 13.7 4.8 13.7 4.5 13.5 4.3 L 12.1 2.9 C 11.9 2.7 11.6 2.7 11.4 2.9 L 10.7 3.5 C 10.3 3.2 9.9 3 9.5 2.8 Z M 8 5.5 C 9.4 5.5 10.5 6.6 10.5 8 C 10.5 9.4 9.4 10.5 8 10.5 C 6.6 10.5 5.5 9.4 5.5 8 C 5.5 6.6 6.6 5.5 8 5.5 Z"
                                Fill="#94A3B8"
                                Width="12"
                                Height="12"
                                Stretch="Uniform"
                            />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <Border
                                        Width="336"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        Padding="16"
                                        CornerRadius="8"
                                        BoxShadow="0 4 20 0 #18000000"
                                    >
                                        <StackPanel Spacing="12">
                                            <!-- 浮窗头部标题与计数徽章 (严格垂直居中对齐) -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock
                                                        Text="屏蔽词规则标签"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#0F172A"
                                                    />
                                                    <TextBlock
                                                        Text="命中以下关键词的节点将被自动清洗过滤"
                                                        FontSize="11"
                                                        Foreground="#64748B"
                                                    />
                                                </StackPanel>
                                                <!-- 数学重构：8pt 网格标准微型胶囊 Badge -->
                                                <Border
                                                    Grid.Column="1"
                                                    Background="#F1F5F9"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center"
                                                >
                                                    <TextBlock
                                                        Name="KeywordCountText"
                                                        Text="14 个"
                                                        FontSize="10.5"
                                                        FontWeight="Medium"
                                                        Foreground="#64748B"
                                                    />
                                                </Border>
                                            </Grid>

                                            <!-- 药丸胶囊标签流：定高 114px 物理锁定高度，彻底消灭增删词时的跳跃抖动 -->
                                            <Grid Height="114">
                                                <ScrollViewer
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    VerticalScrollBarVisibility="Auto"
                                                >
                                                    <ItemsControl Name="KeywordsItemsControl">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border
                                                                    Background="#F1F5F9"
                                                                    BorderBrush="#E2E8F0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Height="24"
                                                                    Padding="8,0,6,0"
                                                                    Margin="0,0,6,6"
                                                                >
                                                                    <StackPanel
                                                                        Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        VerticalAlignment="Center"
                                                                    >
                                                                        <TextBlock
                                                                            Text="{Binding}"
                                                                            FontSize="11.5"
                                                                            Foreground="#334155"
                                                                            VerticalAlignment="Center"
                                                                        />
                                                                        <Button
                                                                            Classes="chip-remove-btn"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Padding="0"
                                                                            Tag="{Binding}"
                                                                            Click="OnRemoveKeywordClick"
                                                                            VerticalAlignment="Center"
                                                                        >
                                                                            <TextBlock
                                                                            Text="✕"
                                                                            FontSize="8.5"
                                                                            Foreground="#94A3B8"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                        />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <!-- 0 关键词时的空状态优雅提示 (文字居中，卡片高度分毫不动) -->
                                                <TextBlock
                                                    Name="EmptyKeywordsNotice"
                                                    Text="暂无屏蔽词，全部节点将完整保留"
                                                    FontSize="11.5"
                                                    Foreground="#94A3B8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="False"
                                                />
                                            </Grid>

                                            <!-- 添加新词输入行：32px 黄金模度高度，24px 嵌入式加号按钮 -->
                                            <Border
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Height="32"
                                                Padding="4"
                                            >
                                                <Grid ColumnDefinitions="*, 24">
                                                    <TextBox
                                                        Name="NewKeywordTextBox"
                                                        Grid.Column="0"
                                                        Watermark="输入关键词，按回车添加..."
                                                        FontSize="11.5"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="8,0,4,0"
                                                        VerticalAlignment="Center"
                                                        KeyDown="OnNewKeywordKeyDown"
                                                    />
                                                    <Button
                                                        Name="AddKeywordButton"
                                                        Grid.Column="1"
                                                        Classes="chip-add-btn"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="4"
                                                        Padding="0"
                                                        Click="OnAddKeywordClick"
                                                        ToolTip.Tip="添加标签"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                    >
                                                        <Path
                                                            Data="M 5,1 V 9 M 1,5 H 9"
                                                            Stroke="#FFFFFF"
                                                            StrokeThickness="1.6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                        />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- 底部快捷辅助操作 -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Button
                                                    Grid.Column="0"
                                                    Content="恢复默认词库"
                                                    Classes="link-btn"
                                                    Click="OnResetKeywordsClick"
                                                />
                                                <Button
                                                    Grid.Column="1"
                                                    Content="清空全部"
                                                    Classes="link-btn-danger"
                                                    Click="OnClearKeywordsClick"
                                                />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Row 3: 主操作按钮 (高度严格 36px，横向撑满底端) -->
                    <Button
                        Grid.Row="3"
                        Name="ConvertButton"
                        Classes="hero-btn"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Click="OnConvertClick"
                    >
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                        >
                            <Path
                                Data="M 7 1 L 2 9 L 6 9 L 5 15 L 12 7 L 8 7 Z"
                                Fill="White"
                                Width="12"
                                Height="14"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Name="ConvertButtonText"
                                Text="解析并转换"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                            />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ==================== 中间：极浅极雅发丝竖线 ==================== -->
                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Fill="#E2E8F0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Margin="0,4"
                />

                <!-- ==================== 右翼：输出区 ==================== -->
                <Grid Grid.Column="2" RowDefinitions="28, *, 20, 36">
                    <!-- Row 0: 右栏顶部结果徽标与状态栏 (高度 28px) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <TextBlock
                            Grid.Column="0"
                            Text="sing-box 配置"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Foreground="#0F172A"
                            VerticalAlignment="Center"
                        />

                        <!-- 结果徽标容器 -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                        >
                            <!-- 初始就绪指示 -->
                            <Border
                                Name="InitialBadge"
                                Background="#F1F5F9"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Padding="7,2.5"
                            >
                                <TextBlock
                                    Text="等待解析"
                                    FontSize="10.5"
                                    FontWeight="Medium"
                                    Foreground="#64748B"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>

                            <!-- 成功节点数量徽标 (带悬停协议浮窗) -->
                            <Border
                                Name="NodeCountBadge"
                                IsVisible="False"
                                Background="#DCFCE7"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Padding="7,2.5"
                                Cursor="Hand"
                                ToolTip.Placement="Bottom"
                                ToolTip.ShowDelay="80"
                            >
                                <TextBlock
                                    Name="NodeCountText"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#15803D"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>

                            <!-- 清洗广告数量徽标 -->
                            <Border
                                Name="FilteredBadge"
                                IsVisible="False"
                                Background="#FEF9C3"
                                BorderBrush="#FDE047"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Padding="7,2.5"
                            >
                                <TextBlock
                                    Name="FilteredText"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="#854D0E"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: JSON 代码预览框 (完全无框通透，左边缘与标题绝对平齐) -->
                    <TextBox
                        Grid.Row="1"
                        Name="OutputTextBox"
                        Background="Transparent"
                        BorderThickness="0"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Stretch"
                        Watermark="解析后的标准 sing-box 节点出站配置将在此处实时显示..."
                        FontWeight="Normal"
                        FontSize="11.5"
                        Foreground="#0F172A"
                        Padding="0,6,0,0"
                        Margin="0,8,0,10"
                    />

                    <!-- Row 2: 辅助状态说明行 (高度严格 20px，与左侧 CheckBox 水平绝对呼应，下边距 10px) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock
                            Grid.Column="1"
                            Text="UTF-8 · 自动识别格式"
                            FontSize="11"
                            FontWeight="Normal"
                            Foreground="#94A3B8"
                            VerticalAlignment="Center"
                        />
                    </Grid>

                    <!-- Row 3: 底部操作按钮栏 (高度严格 36px，按钮宽度各 110px 黄金比，靠右紧凑对齐) -->
                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Height="36"
                    >
                        <Button
                            Name="CopyButton"
                            Classes="action-btn"
                            Width="110"
                            Height="36"
                            Click="OnCopyClick"
                        >
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="6"
                            >
                                <Path
                                    Data="M 4 4 L 10 4 C 11.1 4 12 4.9 12 6 L 12 12 C 12 13.1 11.1 14 10 14 L 4 14 C 2.9 14 2 13.1 2 12 L 2 6 C 2 4.9 2.9 4 4 4 Z M 6 2 L 12 2 C 13.1 2 14 2.9 14 4 L 14 10"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeThickness="1.2"
                                    Fill="Transparent"
                                    Width="13"
                                    Height="13"
                                    Stretch="Uniform"
                                />
                                <TextBlock
                                    Name="CopyButtonText"
                                    Text="复制配置"
                                    FontSize="11.5"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>

                        <Button
                            Name="SaveButton"
                            Classes="action-btn"
                            Width="110"
                            Height="36"
                            Click="OnSaveClick"
                        >
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="6"
                            >
                                <Path
                                    Data="M 3 2 L 11 2 L 13 4 L 13 12 C 13 12.6 12.6 13 12 13 L 3 13 C 2.4 13 2 12.6 2 12 L 2 3 C 2 2.4 2.4 2 3 2 Z M 4 2 L 4 5 L 10 5 L 10 2 M 4 9 L 10 9"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeThickness="1.2"
                                    Fill="Transparent"
                                    Width="13"
                                    Height="13"
                                    Stretch="Uniform"
                                />
                                <TextBlock
                                    Name="SaveButtonText"
                                    Text="保存文件"
                                    FontSize="11.5"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Panel>
</Window>
